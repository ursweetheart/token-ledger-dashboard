# Internal handoff point for the server-side public proxy.
# TLS and public DNS terminate outside this Compose stack.
server {
    listen 8080 default_server;
    server_name _;
    return 444;
}

resolver 127.0.0.11 valid=10s ipv6=off;

upstream gateway_pool {
    zone gateway_pool 64k;
    server gateway-lb:4000 resolve;
}

server {
    listen 8080;
    server_name ${LLM_GATEWAY_DOMAIN};

    client_max_body_size 25m;
    proxy_connect_timeout 10s;
    proxy_send_timeout 600s;
    proxy_read_timeout 600s;

    location = /edge-health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "edge-ok\n";
    }

    location = /v1/chat/completions {
        proxy_pass http://gateway_pool;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-User $http_x_user;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

        proxy_buffering off;
        proxy_cache off;

        # Never replay a paid POST at this layer.
        proxy_next_upstream off;
    }

    location / {
        return 404;
    }
}
