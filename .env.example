# Chep file nay thanh  .env  roi dien vao. File .env DA nam trong .gitignore.
#
#     cp .env.example .env
#
# Co HAI cach, chon mot:
#
#   A. Tai khoan  - script tu goi POST /auth/login lay token moi lan chay.
#                   Chay duoc mot lenh duy nhat, khong phai dan gi.
#   B. Token san  - dan JWT vao <APP>_JWT. Khong luu mat khau xuong dia,
#                   nhung token song ~6h-1 ngay nen phai dan lai thuong xuyen.
#
# Neu dien ca hai thi <APP>_JWT duoc uu tien.
# Bien moi truong that (export/set) luon thang gia tri trong file nay.

# ─── Ralli / CTDA  (https://ralliai.rangdong.com.vn:9001) ───
RALLI_USER=
RALLI_PASS=
# RALLI_JWT=

# ─── TLA Hop Dong  (https://chatbothd.rangdong.com.vn:10001) ───
HD_USER=
HD_PASS=
# HD_JWT=

# ─── Khoa doc API cua dashboard  (backend/main.py) ───
# BAT BUOC. Thieu bien nay thi may chu TU CHOI KHOI DONG - do la chu y, khong
# phai loi: che do hong phai la "khong chay", tuyet doi khong phai "chay mo".
#
# Sinh mot khoa:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Dan ket qua vao dong duoi. Nguoi xem dashboard nhap dung chuoi nay mot lan,
# trinh duyet nho lai. Doi khoa la moi nguoi phai nhap lai.
DASHBOARD_KEY=

# Chi khi PHAT TRIEN. Bo qua xac thuc, may chu in canh bao moi lan khoi dong.
# Dat bien nay tren may co the ra mang = mo lai dung lo hong da bit.
# DASHBOARD_OPEN=1

# Origin duoc phep goi API (CORS). De trong la dung mac dinh:
# null (file://) + 127.0.0.1:8080 + localhost:8080
# DASHBOARD_ORIGINS=http://127.0.0.1:8080

# ─── PostgreSQL cuc bo (docker-compose.yml) ───
# De trong la dung mac dinh duoi day. Chi mo tren 127.0.0.1 nen khong ra mang.
# Doi thi phai `docker compose down -v` roi `up -d` lai, vi mat khau chi duoc
# dat luc container khoi tao lan dau.
# PGDATABASE=token_ledger_v2
# PGUSER=token
# PGPASSWORD=token_local
# PGPORT=5432
# PGHOST=127.0.0.1
# PGADMIN_EMAIL=admin@example.com   (phai co duoi mien, 'admin@local' bi tu choi)
# PGADMIN_PASSWORD=admin_local
# PGADMIN_PORT=5050

# ─── API Gateway (docker compose --profile gateway) ───
# Ba bien duoi day KHONG co gia tri mac dinh. Thieu bat ky bien nao thi container
# LiteLLM DUNG HAN ngay khi khoi dong - khong bao gio chay o che do mo.

# Master key cua LiteLLM. Phai bat dau bang 'sk-'. Sinh mot khoa:
#     python -c "import secrets; print('sk-' + secrets.token_urlsafe(32))"
LITELLM_MASTER_KEY=

# Khoa ma hoa cac Virtual Key luu trong database. DOI KHOA NAY = moi Virtual Key
# da cap deu doc khong ra nua. Sinh mot lan roi giu nguyen:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
LITELLM_SALT_KEY=

# Khoa nha cung cap. Da co san trong .env cua may nay.
# KEY_GOOGLE_AI_STU=

# Khoa Vertex express cua project CRM, tuyen `gemini-2.5-flash` dung. BAT BUOC khi
# bat profile `gateway`: thieu no thi docker/gateway/entrypoint.sh dung han truoc khi
# LiteLLM khoi dong. Che do hong phai la "khong chay", khong phai "chay ma tuyen chet".
#
# Hau to `_GG_AIA_STU` trong ten la GAY HIEU NHAM, giu vi .env dang dung ten do: khoa
# nay KHONG phai AI Studio ma la Vertex express (tien to `AQ.`, 53 ky tu).
# KEY_BENCH_CRM_TEST_GG_AIA_STU=

# Cong va mat khau ha tang Gateway. De trong la dung mac dinh, chap nhan duoc vi
# tat ca deu chi mo tren 127.0.0.1.
# REDIS_PASSWORD=redis_local
# REDIS_PORT=6379
# GATEWAY_PORT=4000          cua vao qua load balancer
# LITELLM_1_PORT=4001        instance 1, mo rieng de dien tap su co
# LITELLM_2_PORT=4002        instance 2

# Database rieng cua Gateway, nam tren CHINH may token-ledger-postgres.
# Khong duoc tro vao token_ledger: phep kiem nghiem thu doi token_ledger co
# DUNG 0 bang ten LiteLLM_*.
# GATEWAY_PGDATABASE=litellm
# GATEWAY_PGUSER=llmproxy
# GATEWAY_PGPASSWORD=llmproxy_local

# --- Log --------------------------------------------------------------------
# Muc chi tiet log cua moi tien trinh chay trong container.
#
#   DEBUG    day du - moi thong bao chi tiet, dung khi di tim nguyen nhan
#   INFO     mac dinh - tien do tung buoc, canh bao, loi, VA MOI DONG SO DO
#   WARNING  im - chi con canh bao va loi
#
# Bien nay TU CHAY XUONG tien trinh con (subprocess ke thua os.environ), nen dat
# mot lan la ca ba tang pipeline deu nghe. Doi cho MOT lan chay ma khong sua file:
#   docker compose --profile tools run -e LOG_LEVEL=DEBUG tools
LOG_LEVEL=INFO

# --- Lam moi so Gateway -----------------------------------------------------
# Nhip cua dich vu `ledger-refresh` (profile "refresh"), don vi GIAY.
#
# Mac dinh 120. Can cu: do 09/09/2026 mot chu ky lam moi mat 2.348 ms tren 444
# dong so nguon, tuc 2% cua 120 giay. Ngan hon khong mua them gi -- bang tong
# hop min nhat la THEO NGAY.
#
# NGUONG cua phep kiem do tre tu theo: dich vu GHI nhip that cua no vao
# `ref_load_run.every_seconds`, va ca scripts/audit_db.py lan /api/health deu doc
# nhip tu do chu khong doc bien nay. Nen doi o day la du, khong phai sua cho khac.
#   docker compose --profile refresh up -d
REFRESH_EVERY_SECONDS=120
