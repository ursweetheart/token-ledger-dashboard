# Chep file nay thanh  .env  roi dien vao. File .env DA nam trong .gitignore.
#
#     cp .env.example .env
#
# Co HAI cach, chon mot:
#
#   A. Tai khoan  - script tu goi POST /auth/login lay token moi lan chay.
#                   Chay duoc mot lenh duy nhat, khong phai dan gi.
#   B. Token san  - dan JWT vao <APP>_JWT. Khong luu mat khau xuong dia,
#                   nhung token song ~6h-1 ngay nen phai dan lai thuong xuyen.
#
# Neu dien ca hai thi <APP>_JWT duoc uu tien.
# Bien moi truong that (export/set) luon thang gia tri trong file nay.

# ─── Ralli / CTDA  (https://ralliai.rangdong.com.vn:9001) ───
RALLI_USER=
RALLI_PASS=
# RALLI_JWT=

# ─── TLA Hop Dong  (https://chatbothd.rangdong.com.vn:10001) ───
HD_USER=
HD_PASS=
# HD_JWT=

# ─── Docker Compose deployment ───
# Required blank values must be filled in .env and never committed.
# Generate each password with this PowerShell command (32-character URL-safe hexadecimal):
# -join ((1..32) | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })
PGDATABASE=token_ledger
PGUSER=token
PGPASSWORD=
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=
PGADMIN_PORT=5050
LOCAL_PORT=8080
PUBLIC_PORT=45501
TLS_CERT_FILE=C:/certs/dashboard/fullchain.pem
TLS_KEY_FILE=C:/certs/dashboard/private.key
SQLITE_SOURCE=./var/token_ledger.sqlite
APP_TAG=local
