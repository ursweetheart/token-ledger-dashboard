# Without this, every build ships data/ (2.3 GB) to the Docker daemon.

.git/
.github/
.agent/
.claude/
.codex/

.env
.env.*
!.env.example
secrets/

# Data reaches the server through a mounted volume, never inside an image.
data/
var/
backups/
*.sqlite
*.sqlite3
*.db
*.dump
*.backup
*.bak

*.key
*.pem
*.crt
*.cer
*.pfx
*.p12

__pycache__/
*.pyc
*.log
node_modules/

docs/
planning/
openspec/
tools/*
!tools/gateway-status/
tests/
