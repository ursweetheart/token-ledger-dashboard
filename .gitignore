# Dữ liệu nguồn (không đưa lên git)
#
# Viết `data/*` chứ không phải `data/`: git KHÔNG đi vào thư mục đã bị loại, nên
# với `data/` thì mọi dòng `!data/...` bên dưới đều vô hiệu — và vô hiệu trong im
# lặng, `git status` vẫn sạch y như khi ngoại lệ có tác dụng. Phải mở khoá từng
# cấp một xuống tới thư mục cần giữ.
data/*

# Ngoại lệ: danh mục SKU + bảng giá của Google (620 KB). Đây là dữ liệu THAM
# CHIẾU công khai, không phải dữ liệu thu thập được, và db/sinh_02_danh_muc.py
# cần nó để sinh dim_metric_alias + ref_price. Không đưa lên git thì đồng nghiệp
# clone về sẽ không sinh lại được danh mục nếu chưa có tài khoản GCP.
!data/raw_google_console/
data/raw_google_console/*
!data/raw_google_console/danh_muc/

# File dữ liệu bảng tính / dữ liệu thô
*.xlsx
*.xls
*.xlsm
*.csv
*.tsv

# OS / editor
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*.swp
*~

# Node / build (phòng khi thêm sau này)
node_modules/
dist/
build/
.env
.env.*
# Rieng file mau thi PHAI len git, khong thi nguoi clone ve khong biet can dien gi.
# No chi chua ten bien, khong chua gia tri nao.
!.env.example
*.log

# CSDL SQLite (qua lon cho GitHub, gui rieng)
*.sqlite
*.sqlite3
*.db

# Python cache
__pycache__/
*.pyc

# Workspace cô lập do Superpowers tạo khi thực thi kế hoạch.
.worktrees/
